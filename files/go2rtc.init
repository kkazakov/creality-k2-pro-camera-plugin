#!/bin/sh /etc/rc.common

# go2rtc service for the Creality K2 Pro camera.
# Binary and configuration live on /mnt/UDISK so they survive firmware updates.

START=99
STOP=99
USE_PROCD=1

PROG=/mnt/UDISK/go2rtc/go2rtc
CONF=/mnt/UDISK/go2rtc/go2rtc.yaml
WORKDIR=/mnt/UDISK/go2rtc

start_service() {
    [ -x "$PROG" ] || {
        echo "go2rtc: $PROG not found or not executable"
        return 1
    }
    procd_open_instance
    procd_set_param command "$PROG" -config "$CONF"
    procd_set_param cwd "$WORKDIR"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger "network"
}
